# ZOLANZO Environment Variables
# Copy to .env / .env.local — NEVER commit real secrets.
# Placeholders only. Fill locally after a dedicated ZOLANZO Supabase project exists.

# ── App ──────────────────────────────────────────────
NODE_ENV=development
# development | preview | staging | production
ZOLANZO_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info
# SKIP_ENV_VALIDATION=1

# ── Supabase (ZOLANZO project ONLY — never BamSignal-Engine) ─
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Postgres (Prisma → ZOLANZO Supabase) ─────────────
# Pooler URL for runtime queries (port 6543 + pgbouncer)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Direct URL for Prisma Migrate (port 5432)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ── Security ─────────────────────────────────────────
# Generate with: openssl rand -hex 32
CSRF_SECRET=
WEBHOOK_SIGNING_SECRET=

# ── Rate limiting / cache (optional Redis) ───────────
RATE_LIMIT_REDIS_URL=
REDIS_URL=

# ── Cron / workers ───────────────────────────────────
# Set to 1 only on a dedicated cron process or intentional embedded runner
# ZOLANZO_CRON_ENABLED=0

# ── Payments (Phase 3B — live adapters later) ────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# FLUTTERWAVE_SECRET_KEY=
# STRIPE_SECRET_KEY=
# MONNIFY_API_KEY=

# ── Email / SMS / Push ───────────────────────────────
RESEND_API_KEY=
SENDCHAMP_API_KEY=
SENDCHAMP_SENDER_ID=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Storage ──────────────────────────────────────────
# supabase | s3 | gcs (adapters later)
STORAGE_PROVIDER=supabase

# ── Ecosystem (optional) ─────────────────────────────
STANKINGS_PASSPORT_URL=
STANKINGS_PASSPORT_KEY=

# ── Queue (future) ───────────────────────────────────
# QUEUE_REDIS_URL=
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# ── OAuth (future — configure in ZOLANZO Supabase Auth) ─
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Observability ────────────────────────────────────
SENTRY_DSN=
OTEL_EXPORTER_ENDPOINT=
# GIT_COMMIT=
# VERCEL_GIT_COMMIT_SHA=
