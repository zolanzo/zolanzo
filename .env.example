# ZOLANZO Environment Variables
# Copy to .env / .env.local — NEVER commit real secrets.
# Placeholders only. Fill locally after a dedicated ZOLANZO Supabase project exists.

# ── App ──────────────────────────────────────────────
NODE_ENV=development
# development | preview | staging | production
ZOLANZO_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=info
# SKIP_ENV_VALIDATION=1

# ── Supabase (ZOLANZO project ONLY — never BamSignal-Engine) ─
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Postgres (Prisma → ZOLANZO Supabase) ─────────────
# Pooler URL for runtime queries (port 6543 + pgbouncer)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
# Direct URL for Prisma Migrate (port 5432)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# ── Security ─────────────────────────────────────────
# Generate with: openssl rand -hex 32
CSRF_SECRET=
# Primary webhook HMAC secret (required for webhook ingress)
WEBHOOK_SIGNING_SECRET=
# Optional comma-separated previous secrets for rotation
WEBHOOK_SIGNING_SECRETS=

# ── Rate limiting / cache (optional Redis) ───────────
RATE_LIMIT_REDIS_URL=
REDIS_URL=

# ── Cron / workers ───────────────────────────────────
# Set to 1 only on a dedicated cron process or intentional embedded runner
# ZOLANZO_CRON_ENABLED=0

# ── Payments (Phase 3B.1 — Paystack) ─────────────────
# Leave empty for stub mode. Set both to enable live Paystack.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Webhook URL to configure in Paystack dashboard:
#   {NEXT_PUBLIC_APP_URL}/api/webhooks/paystack
# Callback / return URL:
#   {NEXT_PUBLIC_APP_URL}/api/payments/callback
# FLUTTERWAVE_SECRET_KEY=
# STRIPE_SECRET_KEY=
# MONNIFY_API_KEY=

# ── Email / SMS / Push ───────────────────────────────
# Leave empty for stub mode. Set RESEND_API_KEY to enable live email.
RESEND_API_KEY=
# e.g. Zolanzo <noreply@yourdomain.com>
RESEND_FROM_EMAIL=
# Svix signing secret from Resend webhook dashboard (whsec_…)
RESEND_WEBHOOK_SECRET=
# Webhook URL: {NEXT_PUBLIC_APP_URL}/api/webhooks/resend
SENDCHAMP_API_KEY=
# Optional. Defaults to https://api.sendchamp.com/api/v1
SENDCHAMP_API_BASE_URL=https://api.sendchamp.com/api/v1
SENDCHAMP_SENDER_ID=
# WhatsApp business sender (E.164 without +)
SENDCHAMP_WHATSAPP_SENDER=
# Optional dedicated webhook HMAC secret (falls back to WEBHOOK_SIGNING_SECRET)
SENDCHAMP_WEBHOOK_SECRET=
# Webhook URL: {NEXT_PUBLIC_APP_URL}/api/webhooks/sendchamp
# Set ZOLANZO_SMS_EMAIL_FALLBACK=0 to disable SMS→email fallback
# ZOLANZO_SMS_EMAIL_FALLBACK=1
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Storage ──────────────────────────────────────────
# supabase (default when service role set) | memory | s3 | gcs
STORAGE_PROVIDER=supabase
# Live Supabase Storage requires NEXT_PUBLIC_SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY
# Buckets: public-brand, avatars, campaign-assets, submission-evidence, exports, temp-uploads

# ── AI Intelligence (Phase 4.1A) ─────────────────────
# Opt-in. Default off → mock provider for health probes only.
# AI_ENABLED=0
# AI_PROVIDER=mock
# Live OpenAI requires AI_ENABLED=1 + AI_PROVIDER=openai + OPENAI_API_KEY
# AI_ENABLED=1
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Match Engine (4.1B) — rule ranking on by default; set to 0 to disable
# AI_MATCH_ENGINE=1
# AI_EXPLAINABILITY=1
# AI_FAIRNESS=1
# Fraud Detection (4.1C) — rule engine on by default
# AI_FRAUD_DETECTION=1
# AI_FRAUD_EXPLAINABILITY=1
# AI_DUPLICATE_ANALYSIS=1
# AI_GEO_ANALYSIS=1
# Review Assistant (4.1D)
# AI_REVIEW_ASSISTANT=1
# AI_REVIEW_SUMMARIES=1
# AI_REVIEW_FEEDBACK=1
# Organization Copilot (4.1E)
# AI_ORG_COPILOT=1
# AI_ORG_MEMORY=1
# AI_ORG_RECOMMENDATIONS=1
# Worker Copilot (4.1F)
# AI_WORKER_COPILOT=1
# AI_WORKER_MEMORY=1
# AI_WORKER_RECOMMENDATIONS=1
# Trust & Reputation (4.2A/B)
# TRUST_ENGINE=1
# TRUST_EXPLAINABILITY=1
# TRUST_TRENDS=1
# TRUST_DECAY_HALF_LIFE_DAYS=90
# Trust Passport (4.2C)
# TRUST_PASSPORT=1
# TRUST_BADGES=1
# TRUST_TIMELINE=1
# Business Intelligence (4.3A)
# ANALYTICS_ENGINE=1
# ANALYTICS_SNAPSHOTS=1
# ANALYTICS_REPORTS=1
# Executive Dashboards (4.3B)
# ANALYTICS_DASHBOARDS=1
# EXECUTIVE_DASHBOARD=1
# OPERATIONS_DASHBOARD=1
# Forecasting (4.3C)
# FORECAST_ENGINE=1
# FORECAST_RECOMMENDATIONS=1
# FORECAST_MODELS=1
# Reports & Exports (4.3D)
# REPORTS_ENGINE=1
# REPORT_EXPORTS=1
# REPORT_SCHEDULES=1
# Workflow Automation (4.4A)
# AUTOMATION_ENGINE=1
# AUTOMATION_RULES=1
# AUTOMATION_ACTIONS=1
# Automation Library (4.4B)
# AUTOMATION_LIBRARY=1
# AUTOMATION_TEMPLATES=1
# Visual Rule Builder (4.4C)
# AUTOMATION_BUILDER=1
# AUTOMATION_SIMULATION=1
# AUTOMATION_IMPORT_EXPORT=1
# Automation Governance (4.4D)
# AUTOMATION_GOVERNANCE=1
# AUTOMATION_APPROVALS=1
# AUTOMATION_AUDIT=1
# Public API Platform (4.5A)
# PUBLIC_API=1
# PUBLIC_API_V1=1
# PUBLIC_OPENAPI=1
# PUBLIC_RATE_LIMITING=1
# PUBLIC_API_RATE_LIMIT_PER_MINUTE=60
# PUBLIC_API_DAILY_QUOTA=10000
# Webhooks (4.5B)
# PUBLIC_WEBHOOKS=1
# WEBHOOK_DELIVERY=1
# WEBHOOK_REPLAY=1
# Integration Marketplace (4.5C)
# INTEGRATION_MARKETPLACE=1
# CONNECTOR_RUNTIME=1
# CONNECTOR_HEALTH=1
# Developer Portal & SDK (4.5D)
# DEVELOPER_PORTAL=1
# SDK_GENERATION=1
# API_EXPLORER=1

# ── Ecosystem (optional) ─────────────────────────────
STANKINGS_PASSPORT_URL=
STANKINGS_PASSPORT_KEY=

# ── Queue (future) ───────────────────────────────────
# QUEUE_REDIS_URL=
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=

# ── OAuth (future — configure in ZOLANZO Supabase Auth) ─
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── Observability ────────────────────────────────────
SENTRY_DSN=
OTEL_EXPORTER_ENDPOINT=
# GIT_COMMIT=
# VERCEL_GIT_COMMIT_SHA=
